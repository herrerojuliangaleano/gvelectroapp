# ── ElectroGV · variables para correr en Docker ───────────────────────────────
# Copiá este archivo como backend/.env y completá los valores reales.
# En Docker, STORAGE_DIR lo fija docker-compose (/app/storage); no hace falta acá.

APP_ENABLED=true

# Seguridad (CAMBIAR en producción)
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Orígenes permitidos (frontend en Vercel/ngrok + local).
CORS_ORIGINS=https://TU-FRONTEND.vercel.app,https://TU-NGROK.ngrok-free.dev,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Google Sheets (rutas relativas dentro del volumen /app/storage)
GOOGLE_CREDENTIALS_FILE=./storage/private/credentials.local.json
GOOGLE_TOKEN_FILE=./storage/private/token.json

# Garantías
WARRANTY_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/TU_ID_DE_PLANILLA/edit
WARRANTY_RAW_SHEET=00_RAW_GARANTIAS
PRODUCT_CATALOG_SHEET=Productos PVP
WARRANTY_SUCURSALES=CASEROS,LANUS,CANNING,NORCENTER
WARRANTY_DEPOSITOS=DEPÓSITO GARANTÍAS,CHICLANA,CORRALES,CACHI,PROVEEDOR,CASEROS,LANUS,CANNING,NORCENTER
WARRANTY_ESTADO_DEFAULT=INGRESADO

# Presupuestos
BUDGET_RAW_SHEET=00_RAW_PRESUPUESTOS
BUDGET_DETAIL_SHEET=00_RAW_PRESUPUESTOS_DETALLE
BUDGET_ESTADO_DEFAULT=PENDIENTE
BUDGET_PRODUCT_CACHE_SECONDS=300
BUDGET_SHIPPING_OPTIONS=Retiro en local=0,Envío a confirmar=0

MAX_RECENT_JOBS=100
