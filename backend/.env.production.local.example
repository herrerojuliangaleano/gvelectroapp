# ElectroGV - mini produccion local (backend local + Postgres prod + ngrok + Vercel)
# Copiar como backend/.env.production.local y completar antes de iniciar.
# IMPORTANTE: no subir backend/.env.production.local a Git.

APP_ENABLED=true

# Seguridad (cambiar antes de seed)
AUTH_SECRET=CAMBIAR_SECRET_LARGO_RANDOM_PROD
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD_PROD

# Puertos host. Desarrollo usa 8000/5432/8080; produccion local usa 8010/5433/8081.
PROD_BACKEND_PORT=8010
PROD_POSTGRES_PORT=5433
PROD_ADMINER_PORT=8081

# PostgreSQL produccion local. Convencion: produccion = electrogv; dev = electrogv_dev.
PROD_POSTGRES_USER=electrogv_prod
PROD_POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB_PROD
PROD_POSTGRES_DB=electrogv

# URLs publicas.
# VERCEL_URL: dominio del frontend en Vercel, sin slash final.
# PROD_NGROK_DOMAIN: dominio fijo de ngrok si tenes reserved domain. Si no, dejar vacio.
# CORS_ORIGINS debe incluir Vercel, ngrok y localhost de prueba.
VERCEL_URL=https://electrogv.vayori.net
PROD_NGROK_DOMAIN=electrogv.ngrok.dev
CORS_ORIGINS=https://electrogv.vayori.net,https://gvelectroapp-git-main-herrerojuliangaleanos-projects.vercel.app,https://electrogv.ngrok.dev,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8010,http://127.0.0.1:8010

# Google OAuth / Sheets. En mini-prod estos archivos viven en:
#   host:      backend/storage-prod/private/credentials.local.json
#   container: /app/storage/private/credentials.local.json
GOOGLE_CREDENTIALS_FILE=./storage/private/credentials.local.json
GOOGLE_TOKEN_FILE=./storage/private/token.json
# Alternativa Vercel/VPS futura: pegar JSON completo en variables de entorno.
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_TOKEN_JSON=

# Firebase Admin para push. En mini-prod:
#   host:      backend/storage-prod/private/firebase-service-account.json
#   container: /app/storage/private/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=./storage/private/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Sheets / catalogos
WARRANTY_SPREADSHEET_URL=
WARRANTY_RAW_SHEET=00_RAW_GARANTIAS
PRODUCT_CATALOG_SHEET=Productos PVP
WARRANTY_SUCURSALES=CASEROS,LANUS,CANNING,NORCENTER
WARRANTY_DEPOSITOS=DEPOSITO GARANTIAS,CHICLANA,CORRALES,CACHI,PROVEEDOR,CASEROS,LANUS,CANNING,NORCENTER
WARRANTY_ESTADO_DEFAULT=INGRESADO

# Presupuestos
BUDGET_RAW_SHEET=00_RAW_PRESUPUESTOS
BUDGET_DETAIL_SHEET=00_RAW_PRESUPUESTOS_DETALLE
BUDGET_ESTADO_DEFAULT=PENDIENTE
BUDGET_PRODUCT_CACHE_SECONDS=300
BUDGET_SHIPPING_OPTIONS=Retiro en local=0,Envio a confirmar=0

MAX_RECENT_JOBS=100
