# Frontend — variables de entorno locales
# Copiar este archivo como `.env.local` si necesitás sobreescribir defaults.
# El archivo `.env.local` está en `.gitignore` y no se versiona.

# URL base del backend.
# - Dejá VACÍO para usar el proxy de Vite (recomendado para modo local).
#   El proxy reenvía /api, /auth, /storage y /downloads a http://127.0.0.1:8000.
# - Definí una URL absoluta para apuntar a otro host (ngrok, staging, etc).
VITE_API_BASE_URL=

# (Opcional) URL para descargar el APK Android desde el botón "Instalar".
# Default: /downloads/electrogv.apk (servido por el backend o por Vercel).
# VITE_ANDROID_APK_URL=/downloads/electrogv.apk
